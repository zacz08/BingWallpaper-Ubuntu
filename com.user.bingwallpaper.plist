<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent template for Bing Wallpaper.
  install.sh fills in __PROJECT_PATH__, __HOUR__ and __MINUTE__ and
  installs the result to ~/Library/LaunchAgents/com.user.bingwallpaper.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.bingwallpaper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_PATH__/RUNME.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_PATH__</string>

    <!--
      Daily schedule. If the Mac is asleep / off at the trigger time,
      launchd will run the job at the next opportunity (typically the
      moment the system wakes), so a missed day is auto-recovered.
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>__HOUR__</integer>
        <key>Minute</key>
        <integer>__MINUTE__</integer>
    </dict>

    <!-- Also run once shortly after login, in case the schedule was missed. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Don't relaunch on exit; this is a one-shot daily job. -->
    <key>KeepAlive</key>
    <false/>

    <!-- Be polite with system resources. -->
    <key>LowPriorityIO</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>__PROJECT_PATH__/picture/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_PATH__/picture/launchd.err.log</string>
</dict>
</plist>
