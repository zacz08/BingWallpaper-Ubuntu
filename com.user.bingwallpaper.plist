<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent template for Bing Wallpaper.
  install.sh fills in __PROJECT_PATH__ and installs the result to
  ~/Library/LaunchAgents/com.user.bingwallpaper.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.bingwallpaper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_PATH__/RUNME.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_PATH__</string>

    <!--
      Trigger strategy:

      `StartInterval` (every 6h) is special: per launchd.plist(5), if the
      timer fires while the Mac is asleep it is COALESCED and runs once
      on the next wake. That makes it the closest native equivalent to
      "fire on first wake of the day", without polling or LaunchEvents.

      Combined with the script's 20h debounce (picture/last_run.txt),
      effective behavior is:
          → run once on the first wake/login of each day
          → never run again that day
          → boot/login also triggers via RunAtLoad
    -->
    <key>StartInterval</key>
    <integer>21600</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- One-shot daily job; do not relaunch on exit. -->
    <key>KeepAlive</key>
    <false/>

    <!-- Be polite with system resources. -->
    <key>LowPriorityIO</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>__PROJECT_PATH__/picture/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_PATH__/picture/launchd.err.log</string>
</dict>
</plist>
